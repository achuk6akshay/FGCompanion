<?xml version="1.0"?>
<PropertyList>
 <generic>
  <output>
   <line_separator>newline</line_separator>
   <var_separator>,</var_separator>

   <chunk>
    <name>latitude</name>
    <type>double</type>
    <format>%.6f</format>
    <node>/position/latitude-deg</node>
   </chunk>

   <chunk>
    <name>longitude</name>
    <type>double</type>
    <format>%.6f</format>
    <node>/position/longitude-deg</node>
   </chunk>

   <chunk>
    <name>altitude</name>
    <type>double</type>
    <format>%.1f</format>
    <node>/position/altitude-ft</node>
   </chunk>

   <chunk>
    <name>airspeed</name>
    <type>double</type>
    <format>%.1f</format>
    <node>/velocities/airspeed-kt</node>
   </chunk>

   <chunk>
    <name>heading</name>
    <type>double</type>
    <format>%.1f</format>
    <node>/orientation/heading-deg</node>
   </chunk>

   <chunk>
    <name>pitch</name>
    <type>double</type>
    <format>%.1f</format>
    <node>/orientation/pitch-deg</node>
   </chunk>

   <chunk>
    <name>roll</name>
    <type>double</type>
    <format>%.1f</format>
    <node>/orientation/roll-deg</node>
   </chunk>

   <chunk>
    <name>vertical-speed</name>
    <type>double</type>
    <format>%.1f</format>
    <node>/velocities/vertical-speed-fps</node>
   </chunk>

  </output>
 </generic>
</PropertyList>
